# ─── Astronomy / Instrumentation Module ──────────────────────────────────────
# Copy values from the root .env; override here only if this module requires
# different settings.

PUID=1000
PGID=1000
TZ=Europe/Madrid
DATA_DIR=/opt/server-pi

# ── Telesco-pi Service ────────────────────────────────────────────────────────
# Port exposed by the telesco-pi application (update to match the app's port)
TELESCO_PORT=5000

# ── Resource Limits ───────────────────────────────────────────────────────────
# Plate-solving is CPU-intensive.  These caps prevent the astrometry workload
# from starving the domotics and telemetry services on the same host.
#
# On a Raspberry Pi 5 (4-core), reserving at most 1.5 cores and 1 GB leaves
# enough headroom for Home Assistant, Mosquitto and Zigbee2MQTT.
TELESCO_CPU_LIMIT=1.5
TELESCO_CPU_RESERVATION=0.5
TELESCO_MEMORY_LIMIT=1g
TELESCO_MEMORY_RESERVATION=256m
