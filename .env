# ─── Global Environment Variables ────────────────────────────────────────────
# These values are referenced by all module-level .env files.
# Run `id -u` and `id -g` on the host to get the correct PUID / PGID.

# User and group ID used for volume ownership
PUID=1000
PGID=1000

# Timezone — see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Madrid

# Base directory for all persistent bind-mount data on the host
DATA_DIR=/opt/server-pi
