# ─── Management Module ────────────────────────────────────────────────────────
# Copy values from the root .env; override here only if this module requires
# different settings.

PUID=1000
PGID=1000
TZ=Europe/Madrid
DATA_DIR=/opt/server-pi

# Portainer — web UI on :9000, agent tunnel on :8000
PORTAINER_PORT=9000
PORTAINER_AGENT_PORT=8000

# Glances web server
GLANCES_PORT=61208

# Homepage dashboard
HOMEPAGE_PORT=3000
