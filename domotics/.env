# ─── Domotics Module ──────────────────────────────────────────────────────────
# Copy values from the root .env; override here only if this module requires
# different settings.

PUID=1000
PGID=1000
TZ=Europe/Madrid
DATA_DIR=/opt/server-pi

# ── Mosquitto MQTT Broker ─────────────────────────────────────────────────────
MQTT_PORT=1883
MQTT_WS_PORT=9001

# ── Zigbee2MQTT ───────────────────────────────────────────────────────────────
Z2M_PORT=8080

# Path to the Zigbee coordinator identified by USB serial ID.
# Run the command below on the host to find the correct ID:
#   ls -l /dev/serial/by-id/
# Then replace the value below with your device's path.
ZIGBEE_DEVICE=/dev/serial/by-id/usb-Silicon_Labs_Sonoff_Zigbee_3.0_USB_Dongle_Plus_0001-if00-port0

# ── Home Assistant ────────────────────────────────────────────────────────────
# Home Assistant uses host networking; no port mapping is required.
# It listens on port 8123 by default.
HASS_CONFIG_DIR=/opt/server-pi/homeassistant
